{
  "name": "adjeltron-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "App desktop do adjeltron (Tauri): a mesma bancada do site, isolada numa janela nativa com servidor local em Rust",
  "scripts": {
    "postinstall": "bun install --cwd ../frontend",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:win": "tauri build --bundles nsis,msi",
    "dev:ui": "node ../frontend/node_modules/vite/bin/vite.js",
    "build:ui": "bun ../frontend/scripts/gen-licenses.mjs && node ../frontend/node_modules/vite/bin/vite.js build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
