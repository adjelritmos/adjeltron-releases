{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "adjeltron",
  "version": "0.5.0",
  "identifier": "app.adjeltron.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Desenho e simulação de circuitos e robôs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/arduino/": "resources/arduino/",
      "resources/arduino-libs/": "resources/arduino-libs/",
      "resources/arduino-compat/": "resources/arduino-compat/"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
