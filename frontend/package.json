{
  "name": "adjeltron",
  "version": "0.3.0",
  "description": "Site do adjeltron (web): bancada virtual de eletrónica e robótica — circuitos 2D, mecânica 3D com física, código Arduino (C/C++) e Fogu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/gen-licenses.mjs && vite build",
    "licenses": "bun scripts/gen-licenses.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "check": "bun scripts/arm-poses.mjs --check && bun scripts/export-sketches.mjs --check && bun scripts/sync-srclibs.mjs --check && bun scripts/check-examples.js",
    "check:fogu": "bun scripts/check-examples.js --fogu",
    "arm-poses": "bun scripts/arm-poses.mjs",
    "export-sketches": "bun scripts/export-sketches.mjs",
    "sync-srclibs": "bun scripts/sync-srclibs.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@heroui/react": "^2.8.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "@types/three": "^0.186.0",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "avr8js": "^0.21.1",
    "buffer": "^6.0.3",
    "fflate": "^0.8.3",
    "framer-motion": "^12.23.12",
    "lucide-react": "^1.68.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "7",
    "rp2040js": "^1.4.1",
    "three": "^0.186.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "vite": "^7.1.2"
  }
}
